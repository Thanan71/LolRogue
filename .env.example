# Copy this file to .env.local and replace the placeholders.

# Public browser configuration
VITE_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-side only. Required by `npm run test:db`; never expose with VITE_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional database logging
VITE_ENABLE_DB_LOGGING=true
VITE_DB_LOG_LEVEL=info
