{
  "name": "lolrogue",
  "private": true,
  "version": "0.2.8",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "postinstall": "node scripts/apply-supabase-auth-patch.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "prebuild": "npm run assets -- verify && npm run release -- edge bundle",
    "postbuild": "npm run assets -- verify --dist && node scripts/write-deployment-identity.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:seed": "node scripts/run-test-seed.mjs",
    "test:db": "node scripts/run-database-test-suite.mjs",
    "test:db:rollback": "node scripts/run-application-rollback-test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck:app && npm run typecheck:scripts && npm run typecheck:e2e",
    "typecheck:app": "tsc --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "typecheck:strict": "node scripts/check-strict-typecheck.mjs",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "node:contract": "node scripts/check-node-version-contract.mjs",
    "check": "npm run check:static && npm run check:unit && npm run check:security && npm run assets -- clean-build && npm run check:build",
    "authority:generate": "node scripts/generate-authority-resolver.mjs",
    "backend:deploy": "node scripts/deploy-backend.mjs",
    "balance:repro": "node scripts/cli.mjs balance repro",
    "check:static": "npm run scripts:inventory:check && node scripts/check-business-boundaries.mjs && npm run release -- artifacts check && npm run format:check && npm run lint && npm run testing -- styles check && npm run typecheck && npm run node:contract && npm run release -- readiness check && npm run testing -- content check",
    "check:unit": "npm run test:coverage",
    "check:security": "npm run testing -- security",
    "check:build": "npm run build && npm run testing -- production-build && npm run testing -- performance budgets",
    "check:db": "npm run database -- validate --yes",
    "check:browser": "npm run test:e2e && npm run test:e2e:production",
    "balance": "node scripts/cli.mjs balance",
    "database": "node scripts/cli.mjs database",
    "assets": "node scripts/cli.mjs assets",
    "release": "node scripts/cli.mjs release",
    "testing": "node scripts/cli.mjs testing",
    "scripts:inventory": "node scripts/generate-scripts-inventory.mjs",
    "scripts:inventory:check": "node scripts/generate-scripts-inventory.mjs --check"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "@tailwindcss/postcss": "^4.2.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/parser": "7.29.9",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "autoprefixer": "^10.6.1",
    "esbuild-authority": "npm:esbuild@0.25.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "supabase": "2.119.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
