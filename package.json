{
  "name": "lolrogue",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "prebuild": "npm run assets:verify && npm run edge:bundle",
    "postbuild": "npm run assets:verify:dist && node scripts/write-deployment-identity.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:db": "node scripts/run-database-test-suite.mjs",
    "test:db:list": "node scripts/run-database-test-suite.mjs --list",
    "test:db:rollback": "node scripts/run-application-rollback-test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck:app && npm run typecheck:scripts && npm run typecheck:e2e",
    "typecheck:app": "tsc --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "lint": "biome lint .",
    "csp:styles:check": "node scripts/check-csp-inline-styles.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "node:contract": "node scripts/check-node-version-contract.mjs",
    "audit:security": "node scripts/check-dependency-audit.mjs",
    "check": "npm run format:check && npm run lint && npm run csp:styles:check && npm run typecheck && npm run node:contract && npm run audit:security && npm run release:readiness:check && npm run test:coverage && npm run test:assets-clean && npm run build && npm run test:production-build",
    "migrate": "supabase db push",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "node scripts/run-local-db-lint.mjs",
    "db:types": "supabase gen types typescript --local > src/types/database.ts && biome format --write src/types/database.ts",
    "db:types:check": "npm run db:types && git diff --exit-code -- src/types/database.ts",
    "db:migrations:check": "node scripts/check-database-migration-drift.mjs",
    "db:migrations:check:linked": "node scripts/check-database-migration-drift.mjs --linked",
    "db:security": "node scripts/check-local-db-security.mjs",
    "db:advisors": "node scripts/check-supabase-advisors.mjs --local",
    "db:indexes:check": "node scripts/check-measured-database-indexes.mjs",
    "db:indexes:measure": "node scripts/measure-database-indexes.mjs",
    "db:validate": "npm run db:reset && npm run db:lint && npm run db:security && npm run db:advisors && npm run db:indexes:check && npm run db:migrations:check && npm run db:types:check && node scripts/run-local-db-tests.mjs",
    "authority:generate": "node scripts/generate-authority-resolver.mjs",
    "authority:check": "node scripts/check-authority-registry.mjs",
    "edge:bundle": "npm run authority:check && node scripts/build-authority-bundle.mjs",
    "edge:serve": "npm run edge:bundle && supabase functions serve verify-run",
    "edge:deploy": "npm run edge:bundle && supabase functions deploy verify-run",
    "backend:deploy": "npm run edge:deploy && npm run migrate",
    "ddragon:download": "node scripts/download-ddragon.js",
    "ddragon:parse": "node scripts/parse-champions.js",
    "assets:package": "node scripts/package-riot-assets.mjs",
    "assets:verify": "node scripts/verify-riot-assets.mjs",
    "assets:verify:dist": "node scripts/verify-riot-assets.mjs --dist",
    "test:assets-clean": "node scripts/test-clean-asset-build.mjs",
    "test:production-build": "node scripts/verify-production-build.mjs",
    "test:performance-budgets": "node scripts/check-performance-budgets.mjs",
    "test:performance-preview": "node scripts/measure-local-preview.mjs",
    "test:deployed-assets": "node scripts/verify-deployed-assets.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:readiness:check": "node scripts/release-preflight.mjs --verify-documentation",
    "ops:restore-drill": "node scripts/run-isolated-restore-drill.mjs --local",
    "balance:check": "vitest run tests/balanceSimulation.test.ts tests/contentBalance.test.ts",
    "assets:update": "npm run ddragon:download && npm run ddragon:parse && npm run assets:package && npm run assets:verify"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@vercel/speed-insights": "2.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "7.18.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "2.5.7",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "autoprefixer": "^10.4.27",
    "esbuild-authority": "npm:esbuild@0.25.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "supabase": "2.113.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
